using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using TicketRush.Domain.Enums;

namespace TicketRush.Domain.Entity
{ 

    public class Seat
    {
        public int Id { get; private set; }
        public int ScreenId { get; private set; }
        public Screen Screen { get; private set; } = null!;
        public string Row { get; private set; } = string.Empty;   // "A", "B", "C"...
        public int Number { get; private set; }                    // 1, 2, 3...
        public SeatType Type { get; private set; }

        public string Label => $"{Row}{Number}";

        // Needed by EF Core only for data materialization
        private Seat() { }

        private Seat( Screen screen, string row, int number, SeatType type)
        {
            Screen = screen;
            ScreenId = Screen.Id;
            Row = row;
            Number = number;
            Type = type;
        }

       

        public void ChangeType(SeatType type)
        {
            if (!Enum.IsDefined(typeof(SeatType), type))
                throw new ArgumentOutOfRangeException(nameof(type), "Invalid seat type.");

            Type = type;
        }
    }

}
